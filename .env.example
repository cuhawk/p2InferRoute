# InferRoute environment configuration (copy to .env and adjust).
# The gateway itself reads secrets from the process environment; the YAML config
# references them with ${VAR} placeholders.

# --- Gateway ---------------------------------------------------------------
INFERRROUTE_CONFIG=configs/gateway.yaml
INFERRROUTE_HOST=127.0.0.1
INFERRROUTE_PORT=8000

# --- Authentication (optional) ---------------------------------------------
# Comma-separated API keys. Leave empty to disable auth (local dev only).
INFERRROUTE_API_KEYS=

# --- Optional hosted OpenAI-compatible provider ----------------------------
# Endpoint of any OpenAI-compatible API (OpenAI, OpenRouter, Together, vLLM cloud...).
INFERRROUTE_REMOTE_ENDPOINT=
REMOTE_API_KEY=

# --- Observability ----------------------------------------------------------
# OTLP/HTTP trace endpoint (e.g. http://localhost:4318/v1/traces for the Grafana
# stack / Jaeger). Empty = traces stay local.
INFERRROUTE_OTLP_ENDPOINT=

# --- Cache -------------------------------------------------------------------
# Opt-in exact-request response cache (see docs/adr/0004-response-cache-policy.md).
INFERRROUTE_CACHE_ENABLED=false
